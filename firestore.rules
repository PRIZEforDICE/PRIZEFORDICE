rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasAll(['uid','authorName','text','createdAt']) && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['uid','authorName','title','text','videoUrl','createdAt']) && request.resource.data.keys().hasOnly(['uid','authorName','title','text','videoUrl','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 180 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000 && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() <= 500 && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }
  }
}
